<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.takanuva15.intellijreduxdevtools</id>
    <name>Redux DevTools</name>
    <vendor>takanuva15</vendor>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.RDBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Redux DevTools" anchor="right"
                    factoryClass="com.github.takanuva15.intellijreduxdevtools.toolwindow.RDToolWindowFactory"
                    icon="com.github.takanuva15.intellijreduxdevtools.icons.RDIcons.rdToolWindow"/>
        <projectService
                serviceImplementation="com.github.takanuva15.intellijreduxdevtools.services.RDProjectService"
                id="ReduxDevToolsProjectService"/>
        <registryKey defaultValue="false" key="ide.browser.jcef.redux-devtools.osr.enabled"
                     description="Enables off-screen rendering for Redux DevTools"/>
        <registryKey defaultValue="false" key="com.github.takanuva15.intellijreduxdevtools.showjcefdevtools"
                     description="Enables the JCEF DevTools button for Redux DevTools"/>
    </extensions>

    <actions>
        <action id="intellijreduxdevtools.ShowHelpAction"
                class="com.github.takanuva15.intellijreduxdevtools.actions.ShowHelpAction"/>
        <action id="intellijreduxdevtools.ReloadRDPanelAction"
                class="com.github.takanuva15.intellijreduxdevtools.actions.ReloadRDPanelAction"/>
        <action id="intellijreduxdevtools.OpenDevToolsAction"
                class="com.github.takanuva15.intellijreduxdevtools.actions.OpenDevToolsAction"/>

        <group id="intellijreduxdevtools.RDPanelToolbarActionGroup">
            <reference ref="intellijreduxdevtools.ShowHelpAction"/>
            <reference ref="intellijreduxdevtools.ReloadRDPanelAction"/>
            <separator/>
            <reference ref="intellijreduxdevtools.OpenDevToolsAction"/>
        </group>
    </actions>
</idea-plugin>
