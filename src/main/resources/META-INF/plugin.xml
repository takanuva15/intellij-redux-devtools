<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.takanuva15.intellijreduxdevtools</id>
    <name>Redux DevTools</name>
    <vendor>takanuva15</vendor>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.RDBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Redux DevTools" anchor="right"
                    factoryClass="com.github.takanuva15.intellijreduxdevtools.toolwindow.RDToolWindowFactory"
                    icon="com.github.takanuva15.intellijreduxdevtools.icons.RDIcons.rdToolWindow"/>
        <projectService
                serviceImplementation="com.github.takanuva15.intellijreduxdevtools.services.RDProjectService" id="ReduxDevToolsProjectService"/>
        <projectService
                serviceImplementation="com.github.takanuva15.intellijreduxdevtools.services.RDPluginDisposable"
                id="ReduxDevToolsPluginDisposable"/>
        <registryKey defaultValue="false" key="ide.browser.jcef.redux-devtools.osr.enabled"
                     description="Enables off-screen rendering for Redux DevTools"/>
    </extensions>
</idea-plugin>
